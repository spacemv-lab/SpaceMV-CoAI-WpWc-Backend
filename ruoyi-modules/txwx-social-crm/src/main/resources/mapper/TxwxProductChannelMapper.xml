<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.txwx.social.crm.mapper.TxwxProductChannelMapper">

    <resultMap type="com.txwx.social.crm.domain.po.TxwxProductChannelPO" id="TxwxProductChannelResult">
        <result property="id" column="id"/>
        <result property="productId" column="product_id"/>
        <result property="channelId" column="channel_id"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectProductChannelVo">
        select id, product_id, channel_id, del_flag, create_by, create_time, update_by, update_time from txwx_product_channel
    </sql>

    <select id="selectProductChannelList" parameterType="com.txwx.social.crm.domain.po.TxwxProductChannelPO" resultMap="TxwxProductChannelResult">
        <include refid="selectProductChannelVo"/>
        <where>
            <if test="productId != null">
                and product_id = #{productId}
            </if>
            <if test="channelId != null">
                and channel_id = #{channelId}
            </if>
            and del_flag = '0'
        </where>
    </select>

    <select id="selectProductChannelById" parameterType="Long" resultMap="TxwxProductChannelResult">
        <include refid="selectProductChannelVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <insert id="insertProductChannel" parameterType="com.txwx.social.crm.domain.po.TxwxProductChannelPO">
        insert into txwx_product_channel
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="productId != null">product_id,</if>
            <if test="channelId != null">channel_id,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="productId != null">#{productId},</if>
            <if test="channelId != null">#{channelId},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateProductChannel" parameterType="com.txwx.social.crm.domain.po.TxwxProductChannelPO">
        update txwx_product_channel
        <trim prefix="SET" suffixOverrides=",">
            <if test="productId != null">product_id = #{productId},</if>
            <if test="channelId != null">channel_id = #{channelId},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteProductChannelByIds" parameterType="Long">
        update txwx_product_channel set del_flag = '1' where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteProductChannelBycIds" parameterType="Long">
        update txwx_product_channel set del_flag = '1' where channel_id in
        <foreach collection="cids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectChannelIdsByProductId" parameterType="Long" resultType="Long">
        select channel_id from txwx_product_channel where product_id = #{productId} and del_flag = '0'
    </select>


    <select id="selectChannelIdsByProductIds" resultMap="TxwxProductChannelResult">
        <include refid="selectProductChannelVo"/>
        where product_id in
        <foreach collection="productIds" item="productId" open="(" separator="," close=")">
            #{productId}
        </foreach>
        and del_flag = '0'
    </select>

    <select id="selectProductIdsByChannelId" parameterType="Long" resultType="Long">
        select product_id from txwx_product_channel where channel_id = #{channelId} and del_flag = '0'
    </select>

</mapper>
