<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.iam.mapper.IamUserBackupContactMapper">

    <resultMap id="BaseResultMap" type="com.ruoyi.iam.entity.IamUserBackupContact">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="bak_phone" property="bakPhone"/>
        <result column="bak_email" property="bakEmail"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="del_flag" property="delFlag"/>
    </resultMap>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM iam_user_backup_contact
        WHERE user_id = #{userId} AND del_flag = '0'
        LIMIT 1
    </select>

    <update id="softDeleteByUserId">
        UPDATE iam_user_backup_contact SET del_flag = '1' WHERE user_id = #{userId}
    </update>

</mapper>
