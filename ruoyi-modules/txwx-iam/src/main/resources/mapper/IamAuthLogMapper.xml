<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.iam.mapper.IamAuthLogMapper">

    <resultMap type="com.ruoyi.iam.entity.IamAuthLog" id="IamAuthLogResult">
        <id     property="id"         column="id"          />
        <result property="userId"     column="user_id"     />
        <result property="channelType" column="channel_type" />
        <result property="authType"   column="auth_type"   />
        <result property="authResult" column="auth_result" />
        <result property="failReason" column="fail_reason" />
        <result property="ipAddr"     column="ip_addr"     />
        <result property="userAgent"  column="user_agent"  />
        <result property="authTime"   column="auth_time"   />
    </resultMap>

    <sql id="selectIamAuthLogVo">
        SELECT id, user_id, channel_type, auth_type, auth_result,
               fail_reason, ip_addr, user_agent, auth_time
        FROM iam_auth_log
    </sql>

    <select id="selectById" resultMap="IamAuthLogResult">
        <include refid="selectIamAuthLogVo"/>
        WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO iam_auth_log (
            user_id, channel_type, auth_type, auth_result,
            fail_reason, ip_addr, user_agent, auth_time
        ) VALUES (
            #{userId}, #{channelType}, #{authType}, #{authResult},
            #{failReason}, #{ipAddr}, #{userAgent}, NOW()
        )
    </insert>

</mapper>
