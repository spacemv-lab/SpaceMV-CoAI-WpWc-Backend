<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.txwx.web.mapper.TxwxDropButtonTempMapper">

    <resultMap type="DropButton" id="DropButtonTempResult">
        <result property="dropButtonId"    column="drop_button_id"    />
        <result property="buttonId"    column="button_id"    />
        <result property="text"    column="text"    />
        <result property="link"    column="link"    />
        <result property="state"    column="state"    />
        <result property="sortOrder"    column="sort_order"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectDropButtonTempVo">
        select drop_button_id, button_id, text, link, state, sort_order, create_by, create_time, update_by, update_time, remark from txwx_drop_button_temp
    </sql>

    <select id="selectDropButtonTempList" parameterType="DropButton" resultMap="DropButtonTempResult">
        <include refid="selectDropButtonTempVo"/>
        <where>
            <if test="buttonId != null"> and button_id = #{buttonId}</if>
            <if test="text != null  and text != ''"> and text like concat('%', #{text}, '%')</if>
            <if test="link != null  and link != ''"> and link like concat('%', #{link}, '%')</if>
            <if test="state != null  and state != ''"> and state = #{state}</if>
            <if test="sortOrder != null "> and sort_order = #{sortOrder}</if>
        </where>
        order by sort_order asc, create_time desc
    </select>

    <select id="selectDropButtonTempByDropButtonId" parameterType="Long" resultMap="DropButtonTempResult">
        <include refid="selectDropButtonTempVo"/>
        where drop_button_id = #{dropButtonId}
    </select>

    <select id="selectDropButtonTempListByButtonId" parameterType="Long" resultMap="DropButtonTempResult">
        <include refid="selectDropButtonTempVo"/>
        where button_id = #{buttonId}
        order by sort_order asc, create_time desc
    </select>

    <insert id="insertDropButtonTemp" parameterType="DropButton" useGeneratedKeys="true" keyProperty="dropButtonId">
        insert into txwx_drop_button_temp
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="buttonId != null">button_id,</if>
            <if test="text != null">text,</if>
            <if test="link != null">link,</if>
            <if test="state != null">state,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="buttonId != null">#{buttonId},</if>
            <if test="text != null">#{text},</if>
            <if test="link != null">#{link},</if>
            <if test="state != null">#{state},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateDropButtonTemp" parameterType="DropButton">
        update txwx_drop_button_temp
        <trim prefix="SET" suffixOverrides=",">
            <if test="buttonId != null">button_id = #{buttonId},</if>
            <if test="text != null">text = #{text},</if>
            <if test="link != null">link = #{link},</if>
            <if test="state != null">state = #{state},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where drop_button_id = #{dropButtonId}
    </update>

    <delete id="deleteDropButtonTempByDropButtonId" parameterType="Long">
        delete from txwx_drop_button_temp where drop_button_id = #{dropButtonId}
    </delete>

    <delete id="deleteDropButtonTempByDropButtonIds" parameterType="String">
        delete from txwx_drop_button_temp where drop_button_id in
        <foreach item="dropButtonId" collection="array" open="(" separator="," close=")">
            #{dropButtonId}
        </foreach>
    </delete>

    <delete id="deleteDropButtonTempByButtonId" parameterType="Long">
        delete from txwx_drop_button_temp where button_id = #{buttonId}
    </delete>

    <delete id="clearDropButtonTemp">
        delete from txwx_drop_button_temp
    </delete>

    <!-- 批量插入下拉按钮配置 -->
    <insert id="batchInsertDropButtonTemp" parameterType="java.util.List">
        insert into txwx_drop_button_temp (
            button_id, text, link, state, sort_order, create_by, create_time, update_by, update_time, remark
        )
        values
        <foreach collection="dropButtonList" item="item" separator=",">
            (
                #{item.buttonId}, #{item.text}, #{item.link}, #{item.state}, #{item.sortOrder},
                #{item.createBy}, #{item.createTime}, #{item.updateBy}, #{item.updateTime}, #{item.remark}
            )
        </foreach>
    </insert>

</mapper>
