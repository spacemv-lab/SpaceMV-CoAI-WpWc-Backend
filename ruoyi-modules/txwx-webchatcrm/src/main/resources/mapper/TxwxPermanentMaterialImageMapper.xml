<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.txwx.webchatcrm.mapper.TxwxPermanentMaterialImageMapper">
    <resultMap type="com.txwx.webchatcrm.domain.po.TxwxPermanentMaterialImagePO" id="TxwxPermanentMaterialImageResult">
        <result property="id"         column="id"         />
        <result property="mediaId"    column="media_id"    />
        <result property="name"       column="name"       />
        <result property="url"        column="url"        />
        <result property="delFlag"    column="del_flag"   />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="savedBy"    column="saved_by"    />
        <result property="savedTime"    column="saved_time"    />
        <result property="publishedBy"    column="published_by"    />
        <result property="publishedTime"    column="published_time"    />
        <result property="remark"    column="remark"    />
        <result property="productId"    column="product_id"    />
        <result property="platformId"    column="platform_id"    />
    </resultMap>

    <resultMap type="com.txwx.webchatcrm.domain.vo.WebChatMaterialPermanentVO" id="WebChatPermanentMaterialImageVOResult">
        <result property="media_id"    column="media_id"    />
        <result property="name"       column="name"       />
        <result property="update_time" column="update_time" />
        <result property="url"        column="url"        />
    </resultMap>

